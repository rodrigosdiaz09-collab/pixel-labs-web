{
  "name": "pixel-labs-web",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",

  // El sitio de siempre. Cloudflare sirve estos archivos solo; el código
  // del worker únicamente entra cuando la dirección no es un archivo
  // (o sea: /api/lead y /panel).
  "assets": {
    "directory": "./",
    "not_found_handling": "404-page",
    "binding": "ASSETS",

    // Estas dos direcciones las atiende el código sí o sí. Sin esta línea,
    // /panel podría caer en la página de error 404 antes de llegar al worker,
    // porque el navegador la pide como si fuera una página normal.
    "run_worker_first": ["/api/*", "/panel", "/panel/*"]
  },

  // ── BASE DE CONTACTOS ─────────────────────────────────────────────
  // Está DESACTIVADA a propósito: así el sitio publica sin errores
  // aunque la base todavía no exista.
  //
  // Para activarla corré, en esta carpeta:
  //     node configurar-base.mjs
  //
  // Ese script crea la base, descomenta las líneas de abajo y les pone
  // el identificador que corresponde. No hace falta que lo edites a mano.
  //
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "pixel-labs-leads",
  //     "database_id": "lo-completa-el-script"
  //   }
  // ]
  "observability": { "enabled": true }
}
