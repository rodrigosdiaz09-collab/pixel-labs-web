{
  "name": "pixel-labs-web",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",

  // El sitio de siempre. Cloudflare sirve estos archivos solo; el código
  // del worker únicamente entra cuando la dirección no es un archivo
  // (o sea: /api/lead y /panel).
  "assets": {
    "directory": "./",
    "not_found_handling": "404-page",
    "binding": "ASSETS",

    // Estas dos direcciones las atiende el código sí o sí. Sin esta línea,
    // /panel podría caer en la página de error 404 antes de llegar al worker,
    // porque el navegador la pide como si fuera una página normal.
    "run_worker_first": ["/api/*", "/panel", "/panel/*"]
  },

  // Base de datos de contactos.
  //
  // NO EDITES ESTO A MANO. Corré una sola vez, en esta carpeta:
  //     node configurar-base.mjs
  // Ese script crea la base y escribe acá abajo el identificador que
  // le corresponde. Mientras diga "FALTA-CONFIGURAR", el deploy va a
  // fallar con un error de "database not found", y está bien que falle:
  // es el aviso de que todavía no corriste el script.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pixel-labs-leads",
      "database_id": "FALTA-CONFIGURAR-CORRE-node-configurar-base.mjs"
    }
  ]
}
